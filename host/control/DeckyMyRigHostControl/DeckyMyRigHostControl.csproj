<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DeckyMyRigHostControl</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DeckySigningCertificateThumbprint Condition="'$(DeckySigningCertificateThumbprint)' == ''">UNCONFIGURED</DeckySigningCertificateThumbprint>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../DeckyMyRigHostControl.Core/DeckyMyRigHostControl.Core.csproj" /></ItemGroup>
  <ItemGroup><AssemblyMetadata Include="DeckySigningCertificateThumbprint" Value="$(DeckySigningCertificateThumbprint)" /></ItemGroup>
</Project>
