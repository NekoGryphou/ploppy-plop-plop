{
  "name": "decky-my-rig",
  "version": "0.1.0",
  "description": "Start and shut down Windows gaming PCs from Decky.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "backend:deps": "../scripts/decky/build-decky-deps.sh",
    "dev": "vite build --watch",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run && npm run test:backend && npm run test:integration",
    "test:frontend": "vitest run",
    "test:backend": "PYTHONPATH=py_modules python3 -B -m unittest discover -s tests/backend -v",
    "test:integration": "../scripts/decky/test-decky-my-rig-host-integration.sh",
    "visual": "playwright test --config mockup/playwright.config.ts",
    "visual:serve": "vite --config mockup/vite.config.ts",
    "zip": "../scripts/decky/build-plugin.sh",
    "check": "pnpm run lint && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@decky/ui": "^4.12.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "npm@11.18.0"
}
