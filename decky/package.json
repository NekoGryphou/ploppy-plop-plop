{
  "name": "decky-remote-pc-power",
  "version": "0.1.0",
  "description": "Start and shut down Windows gaming PCs from Decky.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "backend:deps": "../scripts/build-decky-deps.sh",
    "dev": "vite build --watch",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run && PYTHONPATH=py_modules python3 -B -m unittest discover -s tests/backend -v",
    "test:frontend": "vitest run",
    "test:backend": "PYTHONPATH=py_modules python3 -B -m unittest discover -s tests/backend -v",
    "visual": "playwright test --config mockup/playwright.config.ts",
    "visual:serve": "vite --config mockup/vite.config.ts",
    "zip": "../scripts/build-plugin.sh",
    "check": "pnpm run lint && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@decky/ui": "^4.11.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jsdom": "^28.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@9.15.9"
}
